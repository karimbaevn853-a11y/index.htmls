<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PLAY & WIN</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #0b0e14;
            color: #ffffff;
            padding: 12px;
            display: flex;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 420px;
            background: #0b0e14;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Header */
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .close-btn {
            background: none;
            border: none;
            color: #ffffff;
            font-size: 18px;
            cursor: pointer;
        }

        .logo {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 1px;
            background: linear-gradient(90deg, #00f2fe, #4facfe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            border: 1px solid rgba(79, 172, 254, 0.3);
            padding: 6px 14px;
            border-radius: 20px;
            box-shadow: 0 0 15px rgba(79, 172, 254, 0.2);
        }

        .header-actions {
            display: flex;
            gap: 10px;
        }

        .icon-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            cursor: pointer;
        }

        /* User Profile & Balance Bar */
        .profile-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 10px 14px;
            margin-bottom: 15px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 16px;
        }

        .username {
            font-size: 15px;
            font-weight: 600;
        }

        .balance-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(79, 172, 254, 0.3);
            padding: 6px 12px;
            border-radius: 20px;
        }

        .balance-amount {
            font-weight: 700;
            font-size: 15px;
        }

        .add-btn {
            background: #0088cc;
            border: none;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            color: #fff;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        /* Content Area (Secret Society Card example) */
        .card-container {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 20px;
        }

        .game-card {
            background: linear-gradient(145deg, #131823, #0d111a);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }

        .card-tag {
            position: absolute;
            top: 10px;
            left: 10px;
            width: 6px;
            height: 6px;
            background: #ff4b2b;
            border-radius: 50%;
            box-shadow: 0 0 8px #ff4b2b;
        }

        .card-title {
            font-size: 12px;
            font-weight: 700;
            color: #a0aec0;
            margin-bottom: 12px;
            letter-spacing: 0.5px;
            text-align: center;
        }

        .card-image {
            width: 90px;
            height: 70px;
            object-fit: contain;
            margin-bottom: 15px;
            filter: drop-shadow(0 10px 10px rgba(0,0,0,0.5));
        }

        .price-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            width: 100%;
            padding: 8px;
            border-radius: 10px;
            color: #fff;
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .price-btn:hover {
            background: rgba(79, 172, 254, 0.1);
            border-color: rgba(79, 172, 254, 0.4);
        }

        /* Bottom Navigation Bar */
        .nav-bar {
            background: #121824;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            margin-top: auto;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            background: none;
            border: none;
            color: #718096;
            font-size: 11px;
            cursor: pointer;
            transition: color 0.2s;
        }

        .nav-item.active {
            color: #4facfe;
        }

        .nav-icon {
            font-size: 18px;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Yuqori qism (Header) -->
        <div>
            <div class="header">
                <button class="close-btn">✕ Закрыть</button>
                <div class="logo">PLAY & WIN</div>
                <div class="header-actions">
                    <button class="icon-btn">▼</button>
                    <button class="icon-btn">⋮</button>
                </div>
            </div>

            <!-- Profil va Balans -->
            <div class="profile-bar">
                <div class="user-info">
                    <div class="avatar">N</div>
                    <div class="username">N</div>
                </div>
                <div class="balance-box">
                    <span class="balance-amount">0 💎</span>
                    <button class="add-btn">+</button>
                </div>
            </div>
        </div>

        <!-- O'rtadagi kartochkalar (Keyslar) -->
        <div class="card-container">
            <!-- 1-kartochka -->
            <div class="game-card">
                <div class="card-tag"></div>
                <div class="card-title">SECRET SOCIETY</div>
                <!-- Bu yerga o'zingizning rasm havolangizni qo'yasiz -->
                <div style="font-size: 40px; margin-bottom: 15px;">🔮</div>
                <button class="price-btn">20 💎</button>
            </div>

            <!-- 2-kartochka -->
            <div class="game-card">
                <div class="card-tag" style="background: #4facfe; box-shadow: 0 0 8px #4facfe;"></div>
                <div class="card-title">WHALE CLUB</div>
                <div style="font-size: 40px; margin-bottom: 15px;">🏛️</div>
                <button class="price-btn">200 💎</button>
            </div>
        </div>

        <!-- Pastki menyu (Navigation) -->
        <div class="nav-bar">
            <button class="nav-item">
                <span class="nav-icon">📦</span>
                <span>Инвентарь</span>
            </button>
            <button class="nav-item active">
                <span class="nav-icon">🎮</span>
                <span>Игры</span>
            </button>
            <button class="nav-item">
                <span class="nav-icon">📋</span>
                <span>Задания</span>
            </button>
            <button class="nav-item">
                <span class="nav-icon">🏆</span>
                <span>Лидеры</span>
            </button>
        </div>
    </div>

</body>
</html>
